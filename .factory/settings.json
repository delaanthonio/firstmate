{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$DROID_PROJECT_DIR\"/bin/fm-sessionstart-run.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Execute",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$DROID_PROJECT_DIR\"/bin/fm-arm-pretool-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$DROID_PROJECT_DIR\"/bin/fm-turnend-guard.sh"
          }
        ]
      }
    ]
  }
}
